{
  "name": "minecraft-builder-skill",
  "version": "1.0.0",
  "description": "Build, verify, render and paste Minecraft Java structures with a verification gate that catches misplaced and floating blocks.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "shulkr-shot": "scripts/shulkr_shot.mjs"
  },
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "shot": "node scripts/shulkr_shot.mjs",
    "validate": "python3 scripts/validate.py",
    "query": "python3 scripts/nbt_query.py"
  },
  "keywords": [
    "minecraft", "structure", "nbt", "schematic", "fawe", "worldedit",
    "agent", "skill", "claude", "lodestone"
  ]
}
